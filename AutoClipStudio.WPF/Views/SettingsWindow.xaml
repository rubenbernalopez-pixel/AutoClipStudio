<Window x:Class="AutoClipStudio.WPF.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoClipStudio.WPF.Views"
        xmlns:vm="clr-namespace:AutoClipStudio.WPF.ViewModels"
        xmlns:converters="clr-namespace:AutoClipStudio.WPF.Converters"
        mc:Ignorable="d"
        Title="Configuración - AutoClip Studio"
        Height="700"
        Width="600"
        MinHeight="600"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontFamilyPrimary}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Settings content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <TextBlock Text="Configuración"
                       Style="{StaticResource Heading2}"/>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource ModernScrollViewer}"
                      Padding="24">
            <StackPanel>

                <!-- General -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource Heading3}" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Idioma" Style="{StaticResource BodyText}" Width="150" VerticalAlignment="Center"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      SelectedItem="{Binding SettingsModel.Language}"
                                      Width="200"
                                      Height="40">
                                <ComboBoxItem Content="Español (España)" Tag="es-ES"/>
                                <ComboBoxItem Content="English (US)" Tag="en-US"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Tema" Style="{StaticResource BodyText}" Width="150" VerticalAlignment="Center"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      SelectedItem="{Binding SettingsModel.Theme}"
                                      Width="200"
                                      Height="40">
                                <ComboBoxItem Content="Oscuro" Tag="Dark"/>
                                <ComboBoxItem Content="Claro" Tag="Light"/>
                                <ComboBoxItem Content="Sistema" Tag="System"/>
                            </ComboBox>
                        </StackPanel>

                        <CheckBox Content="Comprobar actualizaciones automáticamente"
                                  IsChecked="{Binding SettingsModel.AutoCheckUpdates}"
                                  Margin="0,0,0,8"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        <CheckBox Content="Iniciar minimizado"
                                  IsChecked="{Binding SettingsModel.StartMinimized}"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Paths -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Rutas" Style="{StaticResource Heading3}" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Carpeta de salida" Style="{StaticResource BodyText}" Width="150" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding SettingsModel.OutputDirectory}"
                                     Width="300"
                                     Height="40"
                                     Margin="0,0,8,0"
                                     IsReadOnly="True"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseOutputFolderCommand}"
                                    Content="Examinar"
                                    Height="40"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Carpeta temporal" Style="{StaticResource BodyText}" Width="150" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding SettingsModel.TempDirectory}"
                                     Width="300"
                                     Height="40"
                                     Margin="0,0,8,0"
                                     IsReadOnly="True"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseTempFolderCommand}"
                                    Content="Examinar"
                                    Height="40"/>
                        </StackPanel>

                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding OpenOutputFolderCommand}"
                                Content="Abrir carpeta de salida"
                                HorizontalAlignment="Left"
                                Margin="150,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Video Defaults -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Valores de vídeo por defecto" Style="{StaticResource Heading3}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Ancho" Style="{StaticResource CaptionText}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SettingsModel.DefaultWidth}"
                                         Height="40"
                                         Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Alto" Style="{StaticResource CaptionText}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SettingsModel.DefaultHeight}"
                                         Height="40"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="FPS" Style="{StaticResource CaptionText}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SettingsModel.DefaultFps}"
                                         Height="40"
                                         Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Máx. clips" Style="{StaticResource CaptionText}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SettingsModel.DefaultMaxClips}"
                                         Height="40"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Máx. duración (s)" Style="{StaticResource CaptionText}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SettingsModel.DefaultMaxDuration}"
                                         Height="40"
                                         Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Layout por defecto" Style="{StaticResource CaptionText}"/>
                                <ComboBox Style="{StaticResource ModernComboBox}"
                                          SelectedItem="{Binding SettingsModel.DefaultLayout}"
                                          Height="40"
                                          Margin="0,4,0,0">
                                    <ComboBoxItem Content="Solo pódcast" Tag="solo_podcast"/>
                                    <ComboBoxItem Content="Pelotas y aros" Tag="balls_hoops"/>
                                    <ComboBoxItem Content="Parkour de bloques" Tag="block_parkour"/>
                                    <ComboBoxItem Content="Mi gameplay" Tag="my_gameplay"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Whisper Settings -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Transcripción (Whisper)" Style="{StaticResource Heading3}" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Modelo por defecto" Style="{StaticResource BodyText}" Width="150" VerticalAlignment="Center"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      SelectedItem="{Binding SettingsModel.DefaultModelSize}"
                                      Width="200"
                                      Height="40">
                                <ComboBoxItem Content="tiny (rápido, ~39 MB)" Tag="tiny"/>
                                <ComboBoxItem Content="base (~74 MB)" Tag="base"/>
                                <ComboBoxItem Content="small (~244 MB)" Tag="small"/>
                                <ComboBoxItem Content="medium (~769 MB)" Tag="medium"/>
                                <ComboBoxItem Content="large-v3 (mejor, ~1.5 GB)" Tag="large-v3"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Idioma por defecto" Style="{StaticResource BodyText}" Width="150" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding SettingsModel.DefaultLanguage}"
                                     Width="100"
                                     Height="40"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Dispositivo" Style="{StaticResource BodyText}" Width="150" VerticalAlignment="Center"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      SelectedItem="{Binding SettingsModel.WhisperDevice}"
                                      Width="200"
                                      Height="40">
                                <ComboBoxItem Content="Auto (GPU si disponible)" Tag="auto"/>
                                <ComboBoxItem Content="CPU" Tag="cpu"/>
                                <ComboBoxItem Content="CUDA (GPU NVIDIA)" Tag="cuda"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Precisión" Style="{StaticResource BodyText}" Width="150" VerticalAlignment="Center"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      SelectedItem="{Binding SettingsModel.WhisperComputeType}"
                                      Width="200"
                                      Height="40">
                                <ComboBoxItem Content="float16 (rápido, GPU)" Tag="float16"/>
                                <ComboBoxItem Content="int8 (rápido, CPU)" Tag="int8"/>
                                <ComboBoxItem Content="float32 (preciso, lento)" Tag="float32"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Subtitle Settings -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Subtítulos" Style="{StaticResource Heading3}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Tamaño de fuente" Style="{StaticResource CaptionText}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SettingsModel.SubtitleFontSize}"
                                         Height="40"
                                         Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Fuente" Style="{StaticResource CaptionText}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SettingsModel.SubtitleFontFamily}"
                                         Height="40"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Duración por línea (s)" Style="{StaticResource CaptionText}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SettingsModel.SubtitleLineDuration}"
                                         Height="40"
                                         Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Máx. palabras/linea" Style="{StaticResource CaptionText}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SettingsModel.MaxWordsPerLine}"
                                         Height="40"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Máx. líneas simultáneas" Style="{StaticResource CaptionText}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding SettingsModel.MaxLines}"
                                     Height="40"
                                     Margin="0,4,0,0"
                                     Width="100"
                                     HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Advanced -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Avanzado" Style="{StaticResource Heading3}" Margin="0,0,0,16"/>

                        <CheckBox Content="Aceleración GPU (si disponible)"
                                  IsChecked="{Binding SettingsModel.EnableGpuAcceleration}"
                                  Margin="0,0,0,8"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Máx. trabajos concurrentes" Style="{StaticResource BodyText}" Width="200" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding SettingsModel.MaxConcurrentJobs}"
                                     Width="80"
                                     Height="40"/>
                        </StackPanel>

                        <CheckBox Content="Mantener archivos temporales tras completar"
                                  IsChecked="{Binding SettingsModel.KeepTempFiles}"
                                  Margin="0,0,0,8"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Nivel de registro" Style="{StaticResource BodyText}" Width="150" VerticalAlignment="Center"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      SelectedItem="{Binding SettingsModel.LogLevel}"
                                      Width="150"
                                      Height="40">
                                <ComboBoxItem Content="DEBUG" Tag="DEBUG"/>
                                <ComboBoxItem Content="INFO" Tag="INFO"/>
                                <ComboBoxItem Content="WARNING" Tag="WARNING"/>
                                <ComboBoxItem Content="ERROR" Tag="ERROR"/>
                            </ComboBox>
                        </StackPanel>

                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding CheckUpdatesCommand}"
                                Content="Comprobar actualizaciones"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource PrimaryBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>
                <Button Style="{StaticResource GhostButton}"
                        Command="{Binding ResetCommand}"
                        Content="Restaurar valores por defecto"
                        Margin="0,0,12,0"/>
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding SaveCommand}"
                        Content="Cancelar"
                        IsCancel="True"
                        Margin="0,0,12,0"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        Content="Guardar"
                        IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>