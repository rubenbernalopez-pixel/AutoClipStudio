<Window x:Class="AutoClipStudio.WPF.Views.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoClipStudio.WPF.Views"
        xmlns:vm="clr-namespace:AutoClipStudio.WPF.ViewModels"
        xmlns:controls="clr-namespace:AutoClipStudio.WPF.Controls"
        xmlns:converters="clr-namespace:AutoClipStudio.WPF.Converters"
        mc:Ignorable="d"
        Title="Resultados - AutoClip Studio"
        Height="900"
        Width="1200"
        MinHeight="700"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontFamilyPrimary}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ScoreToColorConverter x:Key="ScoreToColor"/>
        <converters:ScoreToPercentConverter x:Key="ScoreToPercent"/>
        <converters:TimeRangeConverter x:Key="TimeRangeConv"/>
        <converters:LayoutToDisplayNameConverter x:Key="LayoutToName"/>
        <converters:DurationToStringConverter x:Key="DurationToStr"/>
        <converters:PathToFolderNameConverter x:Key="PathToFolderName"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32"
                            CornerRadius="8"
                            Background="{StaticResource AccentBrush}"
                            Margin="0,0,14,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#E94560" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <Path Width="18" Height="18"
                              Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,4C12.55,4 13,4.45 13,5C13,5.55 12.55,6 12,6C11.45,6 11,5.55 11,5C11,4.45 11.45,4 12,4M12,18C14.21,18 16,16.21 16,14C16,12.79 15.21,11.79 14,11.5V8H10V11.5C8.79,11.79 8,12.79 8,14C8,16.21 9.79,18 12,18Z"
                              Fill="White"
                              Stretch="Uniform"
                              Margin="6"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clips generados"
                                   Style="{StaticResource Heading2}"/>
                        <TextBlock>
                            <Run Text="{Binding Clips.Count}" Style="{StaticResource BodySecondary}"/>
                            <Run Text=" clip" Style="{StaticResource BodySecondary}"/>
                            <Run Text="{Binding Clips.Count, Converter={StaticResource PluralConverter}}" Style="{StaticResource BodySecondary}"/>
                            <Run Text=" listo" Style="{StaticResource BodySecondary}"/>
                            <Run Text="{Binding Clips.Count, Converter={StaticResource PluralConverter}}" Style="{StaticResource BodySecondary}"/>
                            <Run Text=" para revisar" Style="{StaticResource BodySecondary}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenOutputFolderCommand}"
                            Content="📁 Abrir carpeta"
                            Margin="0,0,12,0"
                            Padding="16,10"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewProjectCommand}"
                            Content="➕ Nuevo proyecto"
                            Padding="16,10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Clips List -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource ModernScrollViewer}"
                      Padding="28">
            <ItemsControl ItemsSource="{Binding Clips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ClipCard DataContext="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource PrimaryBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource TextMutedBrush}">
                    <Run Text="AutoClip Studio • "/>
                    <Run Text="{Binding Clips.Count}"/>
                    <Run Text=" clip"/>
                    <Run Text="{Binding Clips.Count, Converter={StaticResource PluralConverter}}"/>
                    <Run Text=" • Carpeta: "/>
                    <Run Text="{Binding SourceVideoPath, Converter={StaticResource PathToFolderName}}"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportAllCommand}"
                            Content="📦 Exportar todos"
                            Margin="0,0,12,0"
                            Padding="16,10"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewProjectCommand}"
                            Content="➕ Nuevo proyecto"
                            Padding="16,10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>