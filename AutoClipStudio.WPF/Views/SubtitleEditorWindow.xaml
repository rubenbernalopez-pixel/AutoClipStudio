<Window x:Class="AutoClipStudio.WPF.Views.SubtitleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoClipStudio.WPF.Views"
        xmlns:vm="clr-namespace:AutoClipStudio.WPF.ViewModels"
        xmlns:controls="clr-namespace:AutoClipStudio.WPF.Controls"
        xmlns:converters="clr-namespace:AutoClipStudio.WPF.Converters"
        mc:Ignorable="d"
        Title="Editor de subtítulos - AutoClip Studio"
        Height="780"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontFamilyPrimary}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DurationToStringConverter x:Key="DurationToStr"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28"
                            CornerRadius="6"
                            Background="{StaticResource AccentBrush}"
                            Margin="0,0,12,0">
                        <Path Width="16" Height="16"
                              Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,4C12.55,4 13,4.45 13,5C13,5.55 12.55,6 12,6C11.45,6 11,5.55 11,5C11,4.45 11.45,4 12,4M12,18C14.21,18 16,16.21 16,14C16,12.79 15.21,11.79 14,11.5V8H10V11.5C8.79,11.79 8,12.79 8,14C8,16.21 9.79,18 12,18Z"
                              Fill="White"
                              Stretch="Uniform"
                              Margin="5"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Revisar y corregir subtítulos"
                                   Style="{StaticResource Heading2}"/>
                        <TextBlock Text="{Binding Clip.Id}"
                                   Style="{StaticResource BodySecondary}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding PlayVideoCommand}"
                            Content="▶ Reproducir vídeo"
                            Margin="0,0,12,0"
                            Padding="16,10"/>
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding ExportSrtCommand}"
                            Content="📄 Exportar .SRT"
                            Margin="0,0,12,0"
                            Padding="16,10"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveAndCloseCommand}"
                            Content="✅ Guardar y cerrar"
                            Padding="16,10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: Video Preview + Subtitle Editor -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Video Preview Panel -->
            <Border Grid.Column="0"
                    Background="{StaticResource PrimaryDarkBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Margin="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Video Player -->
                    <MediaElement x:Name="VideoPlayer"
                                  Grid.Row="0"
                                  Source="{Binding VideoPath}"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Stretch="Uniform"
                                  ScrubbingEnabled="True"/>

                    <!-- Video Controls -->
                    <Border Grid.Row="1"
                            Background="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16">
                        <StackPanel>
                            <Slider x:Name="VideoProgress"
                                    Height="6"
                                    Minimum="0"
                                    Maximum="{Binding VideoDuration}"
                                    Value="{Binding VideoPosition, Mode=TwoWay}"
                                    Style="{StaticResource ModernSlider}"
                                    IsMoveToPointEnabled="True"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Style="{StaticResource IconButton}"
                                        Command="{Binding VideoSeekBackCommand}"
                                        ToolTip="Retroceder 5s (←)"
                                        Width="44" Height="44">
                                    <Path Width="22" Height="22"
                                          Data="M12,4V16L4,8M18,4V16L10,8"
                                          Fill="{StaticResource TextPrimaryBrush}"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}"
                                        Command="{Binding VideoPlayPauseCommand}"
                                        ToolTip="Reproducir/Pausar (Espacio)"
                                        Width="52" Height="52">
                                    <Path x:Name="PlayPauseIcon"
                                          Width="28" Height="28"
                                          Data="M8,5V19L19,12Z"
                                          Fill="{StaticResource TextPrimaryBrush}"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}"
                                        Command="{Binding VideoSeekForwardCommand}"
                                        ToolTip="Avanzar 5s (→)"
                                        Width="44" Height="44">
                                    <Path Width="22" Height="22"
                                          Data="M12,4V16L20,8M6,4V16L14,8"
                                          Fill="{StaticResource TextPrimaryBrush}"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock x:Name="CurrentTimeText"
                                           Style="{StaticResource MonoText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="00:00"/>
                                <TextBlock Style="{StaticResource MonoText}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text=" / "
                                           Margin="8,0"/>
                                <TextBlock x:Name="TotalTimeText"
                                           Style="{StaticResource MonoText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding VideoDuration, Converter={StaticResource DurationToStr}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Subtitle Editor Panel -->
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="0,0,0,0"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Subtítulos karaoke"
                                       Style="{StaticResource Heading3}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="(🟡 sonando · 🟢 dicho · ⚪ pendiente · 🔴 corregido · ⚠ baja confianza)"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}"
                                    Command="{Binding PlayFromSelectionCommand}"
                                    Content="▶ Desde aquí"
                                    Margin="0,0,8,0"
                                    ToolTip="Reproducir vídeo desde la palabra seleccionada (F9)"/>
                            <Button Style="{StaticResource GhostButton}"
                                    Command="{Binding UndoCommand}"
                                    Content="↶ Deshacer"
                                    Margin="0,0,8,0"
                                    ToolTip="Deshacer última corrección (Ctrl+Z)"/>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ApplyCorrectionsCommand}"
                                    Content="✅ Aplicar correcciones"
                                    ToolTip="Regenera subtítulos con tus correcciones (Ctrl+Enter)"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Subtitle Lines List -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{StaticResource ModernScrollViewer}">
                        <ItemsControl ItemsSource="{Binding SubtitleLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:SubtitleLineControl DataContext="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Legend -->
                    <Border Grid.Row="2"
                            Background="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16"
                            Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Style="{StaticResource Badge}"
                                    Background="{StaticResource SubtitleActiveBrush}"
                                    Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource BadgeText}" Text="🟡 Sonando"/>
                            </Border>
                            <Border Style="{StaticResource Badge}"
                                    Background="{StaticResource SubtitleDoneBrush}"
                                    Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource BadgeText}" Text="🟢 Dicho"/>
                            </Border>
                            <Border Style="{StaticResource Badge}"
                                    Background="{StaticResource SubtitlePendingBrush}"
                                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource BadgeText}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="⚪ Pendiente"/>
                            </Border>
                            <Border Style="{StaticResource Badge}"
                                    Background="{StaticResource SubtitleCorrectedBrush}"
                                    Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource BadgeText}" Text="🔴 Corregido"/>
                            </Border>
                            <Border Style="{StaticResource Badge}"
                                    Background="{StaticResource SubtitleLowConfBrush}"
                                    Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource BadgeText}" Text="⚠ Baja conf."/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource PrimaryBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource TextMutedBrush}">
                    <Run Text="Clip: "/>
                    <Run Text="{Binding Clip.Id}"/>
                    <Run Text=" • "/>
                    <Run Text="{Binding Clip.Duration, Converter={StaticResource DurationToStr}}"/>
                    <Run Text=" • "/>
                    <Run Text="{Binding SubtitleLines.Count}"/>
                    <Run Text=" líneas"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding ExportSrtCommand}"
                            Content="📄 Exportar .SRT"
                            Margin="0,0,12,0"
                            Padding="14,8"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveAndCloseCommand}"
                            Content="✅ Guardar y cerrar"
                            Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>