                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource ModernScrollViewer}"
                      Padding="28">
            <StackPanel>

                <!-- URL Input Card -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Nuevo proyecto"
                                   Style="{StaticResource Heading2}"/>

                        <TextBlock Text="Pega la URL de YouTube y genera clips verticales listos para publicar."
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,0,0,24"/>

                        <!-- URL Input Row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Style="{StaticResource PlaceholderTextBox}"
                                     Tag="https://youtube.com/watch?v=...  o  https://youtu.be/...  o  YouTube Shorts"
                                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Height="52"
                                     FontSize="15"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ValidateUrlCommand}"
                                    Content="Validar URL"
                                    Margin="12,0,8,0"
                                    MinWidth="120"
                                    Height="52"/>

                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding GenerateClipsCommand}"
                                    Content="🚀 Generar clips"
                                    Margin="8,0,0,0"
                                    MinWidth="200"
                                    Height="52"
                                    FontWeight="Semibold"
                                    FontSize="16">
                                <Button.Effect>
                                    <DropShadowEffect Color="#E94560" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/>
                                </Button.Effect>
                            </Button>
                        </Grid>

                        <!-- Validation / Progress Message -->
                        <Border x:Name="ValidationResult"
                                Margin="0,16,0,0"
                                Padding="16"
                                Background="{StaticResource PrimaryDarkBrush}"
                                CornerRadius="10"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠ " FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Style="{StaticResource BodyText}"
                                           Foreground="{StaticResource ErrorBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0"
                                Padding="16"
                                Background="{StaticResource PrimaryDarkBrush}"
                                CornerRadius="10"
                                Visibility="{Binding HasError, Converter={StaticResource InverseBool}, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ " FontSize="18" VerticalAlignment="Center"
                                           Foreground="{StaticResource InfoBrush}"/>
                                <TextBlock Text="{Binding ProgressMessage}"
                                           Style="{StaticResource BodySecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Advanced Settings (Collapsible) -->
                <Expander Header="⚙ Ajustes avanzados"
                          IsExpanded="{Binding ShowAdvancedSettings}"
                          Margin="0,20,0,0"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource SurfaceBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="14">
                    <StackPanel Margin="20,12,20,20">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Max Clips -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Máx. clips" Style="{StaticResource CaptionText}"/>
                                <ComboBox Style="{StaticResource ModernComboBox}"
                                          SelectedItem="{Binding MaxClips}"
                                          Height="44"
                                          Margin="0,6,0,0">
                                    <ComboBoxItem Content="1 clip" Tag="1"/>
                                    <ComboBoxItem Content="2 clips" Tag="2"/>
                                    <ComboBoxItem Content="3 clips (recomendado)" Tag="3" IsSelected="True"/>
                                    <ComboBoxItem Content="4 clips" Tag="4"/>
                                    <ComboBoxItem Content="5 clips" Tag="5"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Max Duration -->
                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                <TextBlock Text="Máx. duración" Style="{StaticResource CaptionText}"/>
                                <ComboBox Style="{StaticResource ModernComboBox}"
                                          SelectedItem="{Binding MaxDuration}"
                                          Height="44"
                                          Margin="0,6,0,0">
                                    <ComboBoxItem Content="30 seg" Tag="30"/>
                                    <ComboBoxItem Content="45 seg" Tag="45"/>
                                    <ComboBoxItem Content="60 seg" Tag="60"/>
                                    <ComboBoxItem Content="75 seg (recomendado)" Tag="75" IsSelected="True"/>
                                    <ComboBoxItem Content="90 seg" Tag="90"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Model Size -->
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Modelo Whisper" Style="{StaticResource CaptionText}"/>
                                <ComboBox Style="{StaticResource ModernComboBox}"
                                          SelectedItem="{Binding ModelSize}"
                                          Height="44"
                                          Margin="0,6,0,0">
                                    <ComboBoxItem Content="tiny (rápido, 39 MB)" Tag="tiny"/>
                                    <ComboBoxItem Content="base (74 MB)" Tag="base"/>
                                    <ComboBoxItem Content="small (244 MB)" Tag="small"/>
                                    <ComboBoxItem Content="medium (769 MB)" Tag="medium"/>
                                    <ComboBoxItem Content="large-v3 (mejor precisión, 1.5 GB)" Tag="large-v3" IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Layout Selection -->
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="Layout de vídeo" Style="{StaticResource CaptionText}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding AvailableLayouts}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedLayoutInfo}"
                                      Height="44"
                                      Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Background Selection (Split Screen) -->
                        <StackPanel Margin="0,20,0,0"
                                    Visibility="{Binding SelectedLayoutInfo.IsSplitScreen, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Fondo animado (pantalla dividida 55/45)" Style="{StaticResource CaptionText}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding SelectedLayoutInfo.AvailableBackgrounds}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedBackground}"
                                      Height="44"
                                      Margin="0,6,0,0">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                            <TextBlock Text="Para 'Mi gameplay': usa el botón Examinar y selecciona tu partida de Minecraft (.mp4)"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <!-- Topic Hint -->
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="Tema opcional (guía la selección de clips)" Style="{StaticResource CaptionText}"/>
                            <TextBox Style="{StaticResource PlaceholderTextBox}"
                                     Tag="Ej: cuando cuenta por qué cerró la tienda, la anécdota del primer cliente, su opinión sobre..."
                                     Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}"
                                     Height="72"
                                     Margin="0,6,0,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Text="Si el tema no aparece, el sistema te avisará y usará selección automática inteligente."
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Progress Section (Visible During Processing) -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <!-- Stage + Progress Bar -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding CurrentStage}"
                                       Style="{StaticResource Heading3}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"/>

                            <ProgressBar Grid.Column="1"
                                         Style="{StaticResource ModernProgressBar}"
                                         Value="{Binding ProgressPercent}"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="10"
                                         VerticalAlignment="Center"
                                         Margin="24,0,24,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding ProgressPercent, StringFormat='{0:F0}%'}"
                                       Style="{StaticResource MonoText}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       MinWidth="55"
                                       TextAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="{Binding ProgressMessage}"
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,14,0,0"/>

                        <TextBlock Style="{StaticResource CaptionText}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="Elemento "/>
                            <Run Text="{Binding CurrentItem}"/>
                            <Run Text=" de "/>
                            <Run Text="{Binding TotalItems}"/>
                        </TextBlock>

                        <!-- Stage Indicators -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,20,0,0">
                            <Border Style="{StaticResource StageIndicator}"
                                    Tag="Descargando"
                                    Background="{Binding CurrentStage, Converter={StaticResource StageToBrush}, ConverterParameter=downloading}"/>
                            <Border Style="{StaticResource StageIndicator}"
                                    Tag="Transcribiendo"
                                    Background="{Binding CurrentStage, Converter={StaticResource StageToBrush}, ConverterParameter=transcribing}"/>
                            <Border Style="{StaticResource StageIndicator}"
                                    Tag="Seleccionando"
                                    Background="{Binding CurrentStage, Converter={StaticResource StageToBrush}, ConverterParameter=selecting}"/>
                            <Border Style="{StaticResource StageIndicator}"
                                    Tag="Renderizando"
                                    Background="{Binding CurrentStage, Converter={StaticResource StageToBrush}, ConverterParameter=rendering}"/>
                            <Border Style="{StaticResource StageIndicator}"
                                    Tag="Subtítulos"
                                    Background="{Binding CurrentStage, Converter={StaticResource StageToBrush}, ConverterParameter=subtitles}"/>
                        </StackPanel>

                        <!-- Cancel / Retry Buttons -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,20,0,0">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CancelCommand}"
                                    Content="Cancelar"
                                    Margin="0,0,12,0"/>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RetryCommand}"
                                    Content="🔄 Reintentar"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Error Display -->
                <Border Style="{StaticResource Card}"
                        Background="#2D1515"
                        BorderBrush="{StaticResource ErrorBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="⚠ " FontSize="20" VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}"/>
                            <TextBlock Text="Error" Style="{StaticResource Heading3}" Foreground="{StaticResource ErrorBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,0,0,16"
                                   TextWrapping="Wrap"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding RetryCommand}"
                                Content="🔄 Reintentar ahora"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource PrimaryBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding CurrentStage}"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="AutoClip Studio v1.0.0"
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>