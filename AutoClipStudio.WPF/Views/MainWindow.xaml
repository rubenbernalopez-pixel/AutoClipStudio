<Window x:Class="AutoClipStudio.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoClipStudio.WPF.Views"
        xmlns:vm="clr-namespace:AutoClipStudio.WPF.ViewModels"
        xmlns:controls="clr-namespace:AutoClipStudio.WPF.Controls"
        xmlns:converters="clr-namespace:AutoClipStudio.WPF.Converters"
        mc:Ignorable="d"
        Title="AutoClip Studio"
        Height="760"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontFamilyPrimary}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:TimecodeConverter x:Key="TimecodeConv"/>
        <converters:StageToBrushConverter x:Key="StageToBrush"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header con Mica effect -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40"
                            CornerRadius="10"
                            Background="{StaticResource AccentBrush}"
                            Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#E94560" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <Path Width="22" Height="22"
                              Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,4C12.55,4 13,4.45 13,5C13,5.55 12.55,6 12,6C11.45,6 11,5.55 11,5C11,4.45 11.45,4 12,4M12,18C14.21,18 16,16.21 16,14C16,12.79 15.21,11.79 14,11.5V8H10V11.5C8.79,11.79 8,12.79 8,14C8,16.21 9.79,18 12,18Z"
                              Fill="White"
                              Stretch="Uniform"
                              Margin="8"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AutoClip Studio"
                                   Style="{StaticResource Heading2}"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Clips de pódcast → Reels, Shorts, TikTok"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Settings Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="Configuración (F1)"
                        Width="44" Height="44">
                    <Path Width="22" Height="22"
                          Data="M19.14,12.94C19.14,12.94 19.14,12.94 19.14,12.94M19.14,12.94C19.14,12.94 19.14,12.94 19.14,12.94M19.14,12.94C18.59,13.54 17.93,14.14 17.14,14.73C16.81,14.56 16.45,14.4 16.07,14.26C16.34,13.87 16.54,13.44 16.66,13M12,4C12,4 12,4 12,4M12,4C12.55,4 13,4.45 13,5C13,5.55 12.55,6 12,6C11.45,6 11,5.55 11,5C11,4.45 11.45,4 12,4M12,4C12.55,4 13,4.45 13,5C13,5.55 12.55,6 12,6C11.45,6 11,5.55 11,5C11,4.45 11.45,4 12,4M4.66,13C4.78,13.44 4.98,13.87 5.25,14.26C4.87,14.4 4.51,14.56 4.18,14.73C3.39,14.14 2.73,13.54 2.18,12.94C2.74,12.28 3.39,11.55 4.04,11C4.29,11.13 4.53,11.26 4.76,11.38C4.59,10.61 4.5,9.78 4.5,8.94C4.5,8.4 4.76,7.88 5.16,7.46C4.23,6.7 3.26,6 2.22,6C1.57,6 1.02,6.5 1,7.16C1.04,8.12 1.2,9.04 1.47,9.88C1.19,9.89 0.92,9.9 0.65,9.9C0.29,9.9 0,9.61 0,9.25C0,8.89 0.29,8.6 0.65,8.6C0.92,8.6 1.19,8.61 1.47,8.62C1.2,9.46 1.04,10.38 1,11.34C1.02,12 1.57,12.5 2.22,12.5C3.26,12.5 4.23,11.8 5.16,11.04C4.76,10.62 4.5,10.1 4.5,9.5C4.5,9.04 4.76,8.58 5.16,8.16C4.23,7.4 3.26,6.74 2.22,6.74C1.18,6.74 0.3,7.44 0.26,8.4C0.3,9.36 1.18,10.06 2.22,10.06C3.26,10.06 4.23,10.72 5.16,11.48C4.76,11.08 4.5,10.56 4.5,10C4.5,9.56 4.76,9.1 5.16,8.68C4.23,7.92 3.26,7.26 2.22,7.26C1.57,7.26 1.02,7.76 1,8.42C1.04,9.38 1.2,10.3 1.47,11.14C1.19,11.11 0.92,11.1 0.65,11.1C0.29,11.1 0,10.81 0,10.45C0,10.09 0.29,9.8 0.65,9.8C0.92,9.8 1.19,9.79 1.47,9.78C1.2,8.94 1.04,8.02 1,7.06C1.02,6.4 1.57,5.9 2.22,5.9C3.26,5.9 4.23,6.56 5.16,7.32C4.76,6.9 4.5,6.38 4.5,5.84C4.5,5.3 4.76,4.78 5.16,4.36C4.23,3.6 3.26,2.94 2.22,2.94C1.57,2.94 1.02,3.44 1,4.1C1.04,3.14 1.2,2.22 1.47,1.38C1.19,1.39 0.92,1.4 0.65,1.4C0.29,1.4 0,1.11 0,0.75C0,0.39 0.29,0.1 0.65,0.1C0.92,0.1 1.19,0.11 1.47,0.12C1.2,1.0 1.04,1.88 1,2.92C1.02,3.86 1.57,4.36 2.22,4.36C3.26,4.36 4.23,5.02 5.16,5.78C4.76,5.38 4.5,4.86 4.5,4.32C4.5,3.78 4.76,3.3 5.16,2.88C4.23,2.12 3.26,1.46 2.22,1.46C1.18,1.46 0.3,2.16 0.26,3.12C0.3,4.08 1.18,4.78 2.22,4.78C3.26,4.78 4.23,5.44 5.16,6.2C4.76,5.8 4.5,5.28 4.5,4.74C4.5,4.3 4.76,3.84 5.