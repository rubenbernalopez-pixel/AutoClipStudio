<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AutoClipStudio.WPF.Controls"
                    xmlns:converters="clr-namespace:AutoClipStudio.WPF.Converters">

    <!-- Custom Clip Card Control -->
    <Style TargetType="local:ClipCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ClipCard">
                    <Border Style="{StaticResource CardHover}"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Preview/Video -->
                                <RowDefinition Height="Auto"/> <!-- Info -->
                                <RowDefinition Height="Auto"/> <!-- Actions -->
                            </Grid.RowDefinitions>

                            <!-- Video Preview Area -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource PrimaryDarkBrush}"
                                    CornerRadius="8,8,0,0"
                                    AspectRatio="9/16"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="PreviewImage"
                                           Source="{TemplateBinding PreviewImage}"
                                           Stretch="UniformToFill"
                                           Visibility="{TemplateBinding HasPreview, Converter={StaticResource BoolToVis}}"/>
                                    <MediaElement x:Name="VideoPlayer"
                                                  Source="{TemplateBinding VideoPath}"
                                                  LoadedBehavior="Manual"
                                                  UnloadedBehavior="Stop"
                                                  Stretch="UniformToFill"
                                                  Visibility="{TemplateBinding HasVideo, Converter={StaticResource BoolToVis}}"/>
                                    <!-- Play Button Overlay -->
                                    <Button Style="{StaticResource IconButton}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{TemplateBinding PlayCommand}"
                                            Visibility="{TemplateBinding ShowPlayButton, Converter={StaticResource BoolToVis}}">
                                        <Path Width="48" Height="48"
                                              Data="M8,5V19L19,12Z"
                                              Fill="{StaticResource TextOnPrimaryBrush}"/>
                                    </Button>
                                    <!-- Duration Badge -->
                                    <Border Style="{StaticResource Badge}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource BadgeText}"
                                                   Text="{TemplateBinding DurationText}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Clip Info -->
                            <Grid Grid.Row="1" Margin="16,16,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Score Badge -->
                                <Border Grid.Column="0"
                                        Style="{StaticResource Badge}"
                                        Background="{Binding ScoreColor, RelativeSource={RelativeSource TemplatedParent}}"
                                        VerticalAlignment="Top"
                                        Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource BadgeText}"
                                               Text="{Binding ScorePercent, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource BodyText}"
                                               Text="{TemplateBinding Hook}"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Text="{TemplateBinding TimecodeRange}"/>
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Text=" • "
                                                   Foreground="{StaticResource SurfaceBorderBrush}"/>
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Text="{TemplateBinding LayoutDisplayName}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Score Breakdown Tooltip Trigger -->
                                <Button Grid.Column="2"
                                        Style="{StaticResource GhostButton}"
                                        Padding="8"
                                        ToolTip="{TemplateBinding ScoreExplanation}"
                                        Command="{TemplateBinding ShowScoreDetailsCommand}">
                                    <Path Width="16" Height="16"
                                          Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10Z"
                                          Fill="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Actions Row -->
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        Margin="16,12,16,16">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Copiar publicación"
                                        Command="{TemplateBinding CopySocialCopyCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Revisar subtítulos"
                                        Command="{TemplateBinding ReviewSubtitlesCommand}"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Exportar"
                                        Command="{TemplateBinding ExportCommand}"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Progress Ring -->
    <Style x:Key="ProgressRing" TargetType="Control">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Ellipse Width="{TemplateBinding Width}"
                                 Height="{TemplateBinding Height}"
                                 Stroke="{StaticResource SurfaceBorderBrush}"
                                 StrokeThickness="3"/>
                        <Ellipse x:Name="ProgressCircle"
                                 Width="{TemplateBinding Width}"
                                 Height="{TemplateBinding Height}"
                                 Stroke="{StaticResource AccentBrush}"
                                 StrokeThickness="3"
                                 StrokeStartLineCap="Round"
                                 StrokeEndLineCap="Round"
                                 StrokeDashArray="0,100"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="PercentText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stage Indicator -->
    <Style x:Key="StageIndicator" TargetType="Border">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Border">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot"
                                     Width="8" Height="8"
                                     Fill="{StaticResource TextMutedBrush}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StageText"
                                       Text="{TemplateBinding Tag}"
                                       Style="{StaticResource BodyText}"
                                       FontWeight="{StaticResource FontWeightMedium}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Layout Preview Card -->
    <Style TargetType="local:LayoutPreviewCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:LayoutPreviewCard">
                    <Border Style="{StaticResource CardHover}"
                            Width="280"
                            Cursor="Hand">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Preview Image -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource PrimaryDarkBrush}"
                                    CornerRadius="8,8,0,0"
                                    AspectRatio="9/16"
                                    ClipToBounds="True">
                                <Image Source="{TemplateBinding PreviewImage}"
                                       Stretch="UniformToFill"/>
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Row="1" Margin="12">
                                <TextBlock Style="{StaticResource Heading3}"
                                           Text="{TemplateBinding DisplayName}"/>
                                <TextBlock Style="{StaticResource BodySecondary}"
                                           Text="{TemplateBinding Description}"
                                           Margin="0,4,0,0"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border Style="{StaticResource Badge}"
                                            Background="{StaticResource SecondaryBrush}"
                                            Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource BadgeText}"
                                                   Text="{TemplateBinding TypeDisplayName}"/>
                                    </Border>
                                    <Border Style="{StaticResource Badge}"
                                            Background="{Binding HasBackground, Converter={StaticResource BoolToAccentBrush}, RelativeSource={RelativeSource TemplatedParent}}">
                                        <TextBlock Style="{StaticResource BadgeText}"
                                                   Text="{TemplateBinding BackgroundDisplayName}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Selection Overlay -->
                            <Border x:Name="SelectionOverlay"
                                    Background="#80E94560"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Path Width="32" Height="32"
                                          Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M10,17L5,12L6.41,10.58L10,14.17L17.59,6.58L19,8L10,17Z"
                                          Fill="White"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardHover}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{TemplateBinding IsSelected}" Value="True">
                                        <Setter TargetName="SelectionOverlay" Property="Visibility" Value="Visible"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Subtitle Editor Word Control -->
    <Style TargetType="local:SubtitleWordControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SubtitleWordControl">
                    <Border x:Name="WordBorder"
                            Padding="4,2"
                            CornerRadius="4"
                            Background="Transparent">
                        <TextBlock x:Name="WordText"
                                   Text="{TemplateBinding WordText}"
                                   Style="{StaticResource BodyText}"
                                   FontWeight="{StaticResource FontWeightMedium}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Pending">
                            <Setter TargetName="WordText" Property="Foreground" Value="{StaticResource SubtitlePendingBrush}"/>
                        </Trigger>
                        <Trigger Property="State" Value="Active">
                            <Setter TargetName="WordText" Property="Foreground" Value="{StaticResource SubtitleActiveBrush}"/>
                            <Setter TargetName="WordBorder" Property="Background" Value="#30FFD700"/>
                        </Trigger>
                        <Trigger Property="State" Value="Done">
                            <Setter TargetName="WordText" Property="Foreground" Value="{StaticResource SubtitleDoneBrush}"/>
                        </Trigger>
                        <Trigger Property="State" Value="Corrected">
                            <Setter TargetName="WordText" Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                            <Setter TargetName="WordBorder" Property="Background" Value="#30E94560"/>
                            <Setter TargetName="WordBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="WordBorder" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="State" Value="LowConfidence">
                            <Setter TargetName="WordBorder" Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                            <Setter TargetName="WordBorder" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="WordBorder" Property="Background" Value="#30FFD600"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Converters -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <converters:BoolToAccentBrushConverter x:Key="BoolToAccentBrush"/>
    <converters:ScoreToColorConverter x:Key="ScoreToColor"/>
    <converters:ScoreToPercentConverter x:Key="ScoreToPercent"/>
    <converters:TimecodeConverter x:Key="TimecodeConv"/>

</ResourceDictionary>